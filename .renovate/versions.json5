{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Disable automerge for CalVer-style versions (e.g. YYYY.MM or YYYY.MM.DD), since they aren't real semver and a 'patch' bump can still ship breaking changes",
      "matchCurrentVersion": "/^v?\\d{4}\\.\\d{1,2}(\\.\\d{1,2})?$/",
      "automerge": false
    },
    {
      "description": "mise uses CalVer, so update types don't signal risk; trust its releases and automerge all updates",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/jdx/mise"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["fireflyiii/core"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/immich-machine-learning"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-cuda$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "codewithcj/sparkyfitness",
        "codewithcj/sparkyfitness_server",
        "codewithcj/sparkyfitness_garmin"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "description": "CNPG extension images also publish immutable <version>-<YYYYMMDDhhmm>-<pg>-<distro> tags. Docker versioning folds the timestamp into the tag suffix, which no other tag shares, so pinned timestamped tags never update. Rolling <version>-<pg>-<distro> tags work with the default versioning and aren't matched here",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^ghcr\\.io/cloudnative-pg//"],
      "matchCurrentValue": "/^\\d+\\.\\d+\\.\\d+-\\d{12}-\\d+-[a-z]+$/",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d{12})-(?<compatibility>\\d+-[a-z]+)$"
    },
    {
      "description": "vchord-scratch tags are pg<pg-major>-v<semver> (plus per-arch -amd64/-arm64 tags, which this skips)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/tensorchord/vchord-scratch"],
      "versioning": "regex:^pg(?<compatibility>\\d+)-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Postgres extension images (CNPG spec.postgresql.extensions) can need an `ALTER EXTENSION ... UPDATE` and must stay compatible with the app using them, so open PRs but never automerge them. Add new extension images here",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/pgvector",
        "ghcr.io/cloudnative-pg/postgis-extension-testing",
        "ghcr.io/tensorchord/vchord-scratch",
        "ghcr.io/shusaan/timescaledb-testing"
      ],
      "automerge": false
    },
    {
      "description": "LiteLLM ships behaviour and DB changes in minor releases (v1.107.0 had to be reverted, which forced a manual downgrade to 1.106.2), so open a PR and let a human decide instead of automerging it",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/berriai/litellm"],
      "automerge": false
    },
    {
      "description": "Minecraft server version bumps upgrade the world in place (there's no going back) and can break plugins, so never automerge them",
      "matchDatasources": ["custom.papermc"],
      "automerge": false
    },
    {
      "description": "git-sync v4.8.0 wedged homer's rollout (automerge deployed the image, then the init container aborted on the root-owned emptyDir /tmp/git: upstream commit 3f5e7bbe dropped the implicit safe.directory=*, so git rev-parse dies with 'dubious ownership' and the Deployment hits ProgressDeadlineExceeded); homer was reverted to v4.7.1 and this version is also not a published upstream release (no tag/release in kubernetes/git-sync), so never automerge git-sync. Revisit once upstream publishes a release AND homer's git-sync args carry --git-config=safe.directory:*",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.k8s.io/git-sync/git-sync"],
      "automerge": false
    },
    {
      "description": "ghcr.io/renovatebot/renovate ships new tags daily (sometimes several times a day); limit it to a weekly PR instead of flooding the queue",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "schedule": ["before 6am on monday"]
    }
  ]
}
