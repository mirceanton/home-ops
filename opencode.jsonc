{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://llm.home.mirceanton.com/v1"
      },
      "models": {
        // ChatGPT Models
        "gpt-6-sol": { "name": "GPT 6 Sol" },
        "gpt-6-luna": { "name": "GPT 6 Luna" },
        "gpt-5.6-terra": { "name": "GPT 5.6 Terra" },

        // Hosted Qwen Models
        "qwen3.8-max": { "name": "Qwen3.8 Max" },
        "qwen3.8-flash": { "name": "Qwen3.8 Flash" },
        "qwen3.7-plus": { "name": "Qwen3.7 Plus" },

        // Self-Hosted Qwen Models
        "qwen3.8-27b": { "name": "Qwen3.8 27B" },

        // Other Models
        "glm-5.2": { "name": "GLM 5.2" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" }
      }
    }
  }
}
